{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "amber-dental-site",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/",
        "destination": "/sq/",
        "type": 301
      }
    ]
  }
}
